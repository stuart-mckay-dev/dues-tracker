{
  "name": "dues-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply dues-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply dues-tracker --remote",
    "db:reset:local": "wrangler d1 execute dues-tracker --local --command \"DELETE FROM transactions; DELETE FROM posting_runs; DELETE FROM audit_log; DELETE FROM members;\"",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "jose": "^6.2.9",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true,
    "fsevents@2.3.3": true
  }
}
